{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "current": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['t'])"
      }
    },
    "votes": {
      ".read": true,
      "$uid": {
        ".write": true,
        "$pid": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" }
      }
    }
  }
}
